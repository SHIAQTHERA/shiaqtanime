# Koneksi PostgreSQL Supabase
# Supabase Dashboard -> klik "Connect" -> Connection string. Ganti [YOUR-PASSWORD] dengan password database.
# Lokal / VPS (IPv4):   Session pooler     (port 5432)
# Vercel / serverless:  Transaction pooler (port 6543)
DATABASE_URL=postgresql://postgres.PROJECT_REF:[YOUR-PASSWORD]@aws-0-REGION.pooler.supabase.com:5432/postgres
# Opsional: jumlah koneksi maksimum per instance (bawaan 5)
# DATABASE_POOL_MAX=5

# Kunci rahasia untuk menandatangani cookie sesi (string acak panjang, mis. hasil: openssl rand -hex 32)
SESSION_SECRET=ganti-dengan-string-acak-minimal-32-karakter

# Kredensial admin awal (dipakai saat db:seed)
ADMIN_EMAIL=admin@contoh.com
ADMIN_PASSWORD=ganti-password-admin
